# LLM provider: gemini | openai_compatible | mock
LLM_PROVIDER=mock

# Gemini / Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# OpenAI-compatible
OPENAI_BASE_URL=
OPENAI_API_KEY=
MODEL=

# Per-case token budget (stops + escalates when exceeded)
CASE_TOKEN_BUDGET=60000

# Gemini thinking budget (low | medium | high | off)
GEMINI_THINKING=low

# Synthetic data seed
DATA_SEED=7
